# Runtime selection
LLM_PROVIDER=azure_openai
RAG_PROVIDER=azure_search
ENVIRONMENT=development
REQUIRE_API_KEY=false
NEXUSMIND_API_KEY=change-me

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_MODEL=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Microsoft Foundry
FOUNDRY_PROJECT_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT
FOUNDRY_MODEL=

# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://YOUR-SERVICE.search.windows.net
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=nexusmind-enterprise
AZURE_SEARCH_SEMANTIC_CONFIG=
AZURE_SEARCH_VECTOR_FIELD=content_vector
AZURE_SEARCH_CONTENT_FIELD=content
AZURE_SEARCH_ID_FIELD=id

# Enterprise integration
ENTERPRISE_API_ALLOWLIST=api.example.com
ALLOWED_ORIGINS=http://localhost:8000

# Optional local fallback
GROQ_API_KEY=
TAVILY_API_KEY=
CHROMA_PERSIST=./data/nexusmind_chroma
